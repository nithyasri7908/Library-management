  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/stats/",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "stats", ""]
            },
            "description": "Fetch aggregate metrics (total books, available books, borrowed books, members, active loans, overdue loans)."
          }
        }
      ]
    },
